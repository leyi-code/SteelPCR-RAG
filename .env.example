# ==============================================================================
# SteelPCR-RAG environment template
# ------------------------------------------------------------------------------
# Copy this file to `.env` in the repository root and fill in the values.
# `.env` is git-ignored; never commit real credentials.
#
# Every value can equally be supplied as a plain environment variable; real
# environment variables take precedence over this file.
#
# ==============================================================================


# ------------------------------------------------------------------ credentials
# Embedding service backing the knowledge base: Qwen3-Embedding-8B, served by
# any OpenAI-compatible /v1/embeddings endpoint.
STEELPCR_EMBED_API_BASE=your api url
STEELPCR_EMBED_API_KEY=your api key
STEELPCR_EMBED_MODEL=Qwen3-Embedding-8B
STEELPCR_EMBED_DIM=4096

# bge-reranker-v2-m3 cross-encoder reranker used by Experiment 1, served by any
# Cohere-compatible /rerank endpoint.
STEELPCR_RERANK_API_URL=your api url
STEELPCR_RERANK_API_KEY=your api key
STEELPCR_RERANK_API_MODEL=BAAI/bge-reranker-v2-m3

# Qwen3-Reranker-8B, the reranker selected for SteelPCR-RAG (Experiments 2-4).
STEELPCR_QWEN3_RERANK_URL=your api url
STEELPCR_QWEN3_RERANK_KEY=your api key
STEELPCR_QWEN3_RERANK_MODEL=Qwen/Qwen3-Reranker-8B

# Cohere Rank 4 Pro (Experiment 2 only), reached through a compatible /rerank
# endpoint.
STEELPCR_COHERE_RERANK_URL=your api url
STEELPCR_COHERE_RERANK_KEY=your api key
STEELPCR_COHERE_RERANK_MODEL=cohere/rerank-4-pro

# Generation endpoint for Experiments 1-4 and for the case-validation
# pipeline, through the official DeepSeek API.
STEELPCR_GEN_API_BASE=https://api.deepseek.com
STEELPCR_GEN_API_KEY=your api key
STEELPCR_GEN_MODEL=deepSeek-flash

# Second generation slot, used by the closed-book baseline conditions of
# Experiment 3. Same official endpoint.
STEELPCR_GEN_STRONG_API_BASE=https://api.deepseek.com
STEELPCR_GEN_STRONG_API_KEY=your api key
STEELPCR_GEN_STRONG_MODEL=deepSeek-flash

# Optional third generation model (Experiment 3). Leave empty to skip.
STEELPCR_GEN_EXTRA_API_BASE=
STEELPCR_GEN_EXTRA_API_KEY=
STEELPCR_GEN_EXTRA_MODEL=

# Independent cross-family judge used for RAGAS scoring: glm-5.3-flash
# (GLM-5.3-Flash in the paper).
STEELPCR_EVAL_API_BASE=https://open.bigmodel.cn/api/paas/v4
STEELPCR_EVAL_API_KEY=your api key
STEELPCR_EVAL_MODEL=glm-5.3-flash

# Embedding model backing the RAGAS answer-similarity component.
STEELPCR_EVAL_EMBED_API_BASE=your api url
STEELPCR_EVAL_EMBED_API_KEY=your api key
STEELPCR_EVAL_EMBED_MODEL=Qwen/Qwen3-Embedding-8B
STEELPCR_EVAL_EMBED_DIM=4096

# Bilingual terminology expansion (SI Text S9). Leave empty to reuse the
# generation endpoint.
STEELPCR_EXPANSION_API_BASE=
STEELPCR_EXPANSION_API_KEY=
STEELPCR_EXPANSION_MODEL=


# ---------------------------------------------------------------- storage paths
# Knowledge-base artefacts. Relative paths resolve against the repository root;
# absolute paths are used verbatim, so the indexes may live outside the repo.
STEELPCR_DENSE_INDEX_DIR=rag_core/cache/dense
STEELPCR_FAISS_INDEX=
STEELPCR_RECORDS=
STEELPCR_SPARSE_INDEX_DIR=rag_core/cache/sparse

# Root of the working tree that holds `QA dataset/` and the evaluation caches.
# Defaults to the repository root.
STEELPCR_WORKSPACE_ROOT=

# Source documents used to build the knowledge base (only needed when
# re-running ingestion; the published repository does not ship the corpus).
# INPUT_MODE=single ingests INPUT_PATH, INPUT_MODE=folder ingests every JSON in INPUT_DIR.
STEELPCR_INPUT_MODE=folder
STEELPCR_INPUT_DIR=
STEELPCR_INPUT_PATH=


# -------------------------------------------------- LightRAG-mix (Experiment 1)
# PostgreSQL holds the key-value, graph and document-status stores.
STEELPCR_PG_HOST=127.0.0.1
STEELPCR_PG_PORT=5432
STEELPCR_PG_USER=postgres
STEELPCR_PG_PASSWORD=
STEELPCR_PG_DATABASE=lightrag
STEELPCR_PG_MAX_CONNECTIONS=50

# Qdrant holds the three vector collections (chunks / entities / relationships).
STEELPCR_QDRANT_URL=http://127.0.0.1:6333
STEELPCR_QDRANT_API_KEY=
STEELPCR_LIGHTRAG_WORKSPACE=graphrag_cache
STEELPCR_LIGHTRAG_LLM_API_BASE=https://api.deepseek.com
STEELPCR_LIGHTRAG_LLM_API_KEY=your api key
STEELPCR_LIGHTRAG_LLM_MODEL=deepSeek-flash
STEELPCR_LIGHTRAG_EMBED_MODEL=Qwen/Qwen3-Embedding-8B
STEELPCR_LIGHTRAG_EMBED_DIM=4096
STEELPCR_LIGHTRAG_INPUT_MODE=single

# Optional local cross-encoder used when the reranker API is disabled.
STEELPCR_RERANKER_MODEL_PATH=./model/bge-reranker-v2-m3


# ------------------------------------------------- paper hyper-parameters
# STEELPCR_TOP_K_RERANK is the context size of SteelPCR-RAG itself (Experiments 3-4 and the
# case-validation pipeline). Experiments 1-2 evaluate the same chain at k = 5, which is fixed
# in evaluation/eval1.py and evaluation/eval2.py.
STEELPCR_TOP_K_RETRIEVE=50
STEELPCR_TOP_K_RERANK=7
STEELPCR_HNSW_EF_SEARCH=128
STEELPCR_CTX_MAX_CHARS_PER_DOC=3000
STEELPCR_CTX_MAX_CHARS_TOTAL=12000
STEELPCR_CTX_ENHANCEMENT=true

# Decoding and service budgets are already carried by each script at the value reported in the
# paper: Experiments 1-2 decode at 0.1, Experiments 3-4 and case validation use deterministic
# decoding (0.0). Leave these blank to keep the per-script values; fill one in only to override
# every experiment at once.
STEELPCR_GEN_TEMPERATURE=
STEELPCR_GEN_MAX_TOKENS=32000
STEELPCR_GEN_TIMEOUT=
STEELPCR_EVAL_TIMEOUT=

# Per-service batch sizes and the rerank call timeout.
STEELPCR_BGE_RERANK_BATCH_SIZE=25
STEELPCR_COHERE_RERANK_BATCH_SIZE=50
STEELPCR_QWEN3_RERANK_BATCH_SIZE=25
STEELPCR_RERANK_API_TIMEOUT=60.0
STEELPCR_GEN_MAX_RETRIES=
STEELPCR_EVAL_MAX_RETRIES=
STEELPCR_RERANK_MAX_RETRIES=
